<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Call state monitoring: detects incoming call number via TelephonyCallback.
         READ_CALL_LOG is NOT requested — call history is stored in Frappe, not read from the device. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <!-- Lets the "Answer" button on the overlay pick up a ringing call directly,
         without the user needing to switch to the system dialer UI. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"/>

    <!-- Overlay: displays CRM caller-identity sheet over the incoming call screen.
         User must explicitly grant this in System Settings → Special App Access. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- Notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Boot auto-start: restarts the call-monitor foreground service after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Full-screen intent: shows overlay on locked screen during an incoming call -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>


    <application
        android:label="CRM Caller"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:appComponentFactory"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory">

        <activity
            android:name="com.example.crm_caller_nxtgen.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- ⚠️ V2 REFACTOR: Switched to 'specialUse' for CRM Context.
             Target SDK 34+ requires 'phoneCall' FGS to be the default Dialer,
             which this app is not. 'specialUse' allows overlay display with justification. -->
        <!--
            NativeCallOverlayService uses ONLY specialUse type.
            "microphone" was removed: targetSDK=36 (Android 16) rejects microphone FGS
            started from the background even with SecurityException catch, because the
            manifest declaration itself triggers full type validation on create.
        -->
        <service
            android:name="com.example.crm_caller_nxtgen.NativeCallOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_TYPE"
                android:value="CRM Contextual Overlay: Displays caller identity and CRM data during incoming phone calls to assist sales agents. Runs only for the duration of a call." />
        </service>

        <!--
            CallMonitorService: Persistent foreground service that listens for incoming calls
            via TelephonyCallback and starts NativeCallOverlayService from a service context
            (bypasses Android 8+ background ForegroundService start restriction).
        -->
        <service
            android:name="com.example.crm_caller_nxtgen.CallMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_TYPE"
                android:value="CRM Call Monitor: Runs persistently to detect incoming calls and display CRM overlay for sales agents even when the app is in the background." />
        </service>

        <!-- CrmCallScreeningService: the Google-sanctioned way to get the real incoming
             number on Android 10+ without READ_CALL_LOG (which Play Protect flags as a
             stalkerware indicator). Only active once the user grants this app the system
             "Caller ID & spam blocking" role — same mechanism Truecaller/Hiya use. This
             service never blocks/rejects calls, it only reads the number. -->
        <service
            android:name="com.example.crm_caller_nxtgen.CrmCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService"/>
            </intent-filter>
        </service>

        <!-- Phone state BroadcastReceiver (fallback when CallMonitorService is down).
             android:permission ensures only the system (which holds READ_PHONE_STATE) can
             trigger this receiver — prevents spoofed broadcasts from other apps. -->
        <receiver
            android:name="com.example.crm_caller_nxtgen.CallStateReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <!-- BootReceiver: restarts CallMonitorService after device reboot.
             android:permission ensures only the system can send BOOT_COMPLETED to this receiver. -->
        <receiver
            android:name="com.example.crm_caller_nxtgen.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>


    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package-visibility allowlist (Android 11+): without this, canLaunchUrl()
             for tel: URIs silently returns false and the Call button does nothing. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>

</manifest>
