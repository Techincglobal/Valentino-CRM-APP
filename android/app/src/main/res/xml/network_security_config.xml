<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP and user-installed CA certs (corporate self-signed).
         Android <domain> elements match literal hostnames, not CIDR ranges, so LAN/VPN
         IP ranges cannot be enumerated here. As an enterprise CRM deployed on controlled
         networks, the IT team is responsible for restricting which server URLs agents use. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
